{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.b-uh.com/schemas/legacy-production-baseline-v1.json",
  "title": "B-UH legacy production baseline",
  "type": "object",
  "required": [
    "schema_version",
    "fixture",
    "platform_version",
    "release_commit",
    "release_path",
    "migration_targets",
    "wheels"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$"},
    "platform_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_path": {"type": "string", "pattern": "^releases/moon-tax/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "migration_targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,99}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+$"}
    },
    "wheels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["distribution", "version", "filename", "git_blob_sha", "sha256"],
        "properties": {
          "distribution": {"type": "string", "minLength": 1, "maxLength": 100},
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.whl$"},
          "git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
