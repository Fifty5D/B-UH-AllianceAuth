{
  "openapi": "3.1.0",
  "info": {
    "title": "B-UH pinned fake ESI",
    "version": "2025-12-16"
  },
  "servers": [
    {
      "url": "/latest"
    }
  ],
  "tags": [
    {
      "name": "Market"
    }
  ],
  "paths": {
    "/markets/{region_id}/orders": {
      "get": {
        "description": "Return deterministic market orders for source-based tests.",
        "operationId": "GetMarketsRegionIdOrders",
        "parameters": [
          {
            "in": "query",
            "name": "order_type",
            "required": true,
            "schema": {
              "default": "all",
              "enum": ["buy", "sell", "all"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "region_id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "type_id",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Compatibility-Date",
            "required": true,
            "schema": {
              "enum": ["2025-12-16"],
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant",
            "schema": {
              "default": "tranquility",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketsRegionIdOrdersGet"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Pages": {
                "schema": {
                  "format": "int64",
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List orders in a region",
        "tags": ["Market"],
        "x-cache-age": 300,
        "x-compatibility-date": "2020-01-01"
      }
    }
  },
  "components": {
    "schemas": {
      "MarketsRegionIdOrdersGet": {
        "items": {
          "$ref": "#/components/schemas/MarketOrder"
        },
        "type": "array"
      },
      "MarketOrder": {
        "properties": {
          "duration": {"format": "int64", "type": "integer"},
          "is_buy_order": {"type": "boolean"},
          "issued": {"format": "date-time", "type": "string"},
          "location_id": {"format": "int64", "type": "integer"},
          "min_volume": {"format": "int64", "type": "integer"},
          "order_id": {"format": "int64", "type": "integer"},
          "price": {"format": "double", "type": "number"},
          "range": {
            "enum": [
              "station",
              "region",
              "solarsystem",
              "1",
              "2",
              "3",
              "4",
              "5",
              "10",
              "20",
              "30",
              "40"
            ],
            "type": "string"
          },
          "system_id": {"format": "int64", "type": "integer"},
          "type_id": {"format": "int64", "type": "integer"},
          "volume_remain": {"format": "int64", "type": "integer"},
          "volume_total": {"format": "int64", "type": "integer"}
        },
        "required": [
          "order_id",
          "type_id",
          "location_id",
          "system_id",
          "volume_total",
          "volume_remain",
          "min_volume",
          "price",
          "is_buy_order",
          "duration",
          "issued",
          "range"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {"type": "string"}
        },
        "required": ["error"],
        "type": "object"
      }
    }
  }
}
