#!/usr/bin/env bash
set -Eeuo pipefail

# This is the only command accepted by the observer SSH key. The key itself is
# additionally forced to this entry point in authorized_keys.
case "${SSH_ORIGINAL_COMMAND:-}" in
    "diagnostics 5") request=5 ;;
    "diagnostics 15") request=15 ;;
    "diagnostics 30") request=30 ;;
    "diagnostics 60") request=60 ;;
    "diagnostics 180") request=180 ;;
    "diagnostics 360") request=360 ;;
    "fingerprint platform-v2") request="fingerprint platform-v2" ;;
    *)
        if [[ "${SSH_ORIGINAL_COMMAND:-}" =~ ^attempt\ (gh-[0-9]{1,20}-[1-9][0-9]{0,5})$ ]]; then
            request="attempt ${BASH_REMATCH[1]}"
        else
            echo "Denied: unsupported observer command." >&2
            exit 64
        fi
        ;;
esac

printf '%s\n' "${request}" | exec sudo -n /usr/local/sbin/buh-github-observe-root
