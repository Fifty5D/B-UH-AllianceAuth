{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.b-uh.com/schemas/platform-v2-deployment-request-v2.json",
  "title": "B-UH Platform v2 deployment request",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "repository",
    "release_commit",
    "release_ref",
    "platform_version",
    "manifest_sha256",
    "workflow_run_id",
    "workflow_run_attempt"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "mode": {"enum": ["preflight", "deploy"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_ref": {"type": "string", "pattern": "^release/platform-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "platform_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "workflow_run_attempt": {"type": "integer", "minimum": 1, "maximum": 1000},
    "recovery_transition": {
      "type": "object",
      "required": ["policy_id", "policy_sha256", "purpose", "releases"],
      "properties": {
        "policy_id": {"const": "production-v0.5.6-published-gap-20260907"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"enum": ["receiver-upgrade-preflight", "production-recovery"]},
        "releases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 9,
          "items": {"$ref": "#/$defs/releaseIdentity"}
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["recovery_transition"]},
      "else": {"not": {"required": ["recovery_transition"]}}
    }
  ],
  "$defs": {
    "releaseIdentity": {
      "type": "object",
      "required": ["manifest_sha256", "platform_version", "release_commit", "release_ref", "source_commit"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_ref": {"type": "string", "pattern": "^release/platform-v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
