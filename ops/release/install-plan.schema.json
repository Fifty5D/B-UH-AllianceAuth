{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auth.b-uh.com/schemas/install-plan-v1.json",
  "title": "B-UH platform declarative install plan",
  "type": "object",
  "required": [
    "schema_version",
    "platform_version",
    "compatibility_sha256",
    "wheels",
    "django_apps",
    "setup_commands"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "platform_version": {"$ref": "#/$defs/semver"},
    "compatibility_sha256": {"$ref": "#/$defs/sha256"},
    "wheels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["component", "distribution", "version", "filename", "sha256"],
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "distribution": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "django_apps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}
    },
    "setup_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
