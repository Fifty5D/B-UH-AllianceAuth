#!/usr/bin/env bash
set -Eeuo pipefail

readonly APP_DIR="/opt/aa-docker"
readonly STATE_DIR="/var/lib/buh-platform-v2"
readonly MAX_LOG_LINES_PER_CONTAINER=250
readonly PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

IFS= read -r request
case "${request}" in
    5|15|30|60|180|360)
        mode=diagnostics
        minutes="${request}"
        ;;
    "fingerprint platform-v2")
        mode=fingerprint
        ;;
    *)
        if [[ "${request}" =~ ^attempt\ (gh-[0-9]{1,20}-[1-9][0-9]{0,5})$ ]]; then
            mode=attempt
            attempt_id="${BASH_REMATCH[1]}"
        else
            echo "Denied: invalid observer request." >&2
            exit 64
        fi
        ;;
esac

if [[ "${mode}" == "attempt" ]]; then
    umask 077
    raw_attempt="$(mktemp -t buh-attempt-raw.XXXXXX)"
    trap 'rm -f -- "${raw_attempt}"' EXIT
    python3 - "${STATE_DIR}/attempts/${attempt_id}.json" "${attempt_id}" >"${raw_attempt}" <<'PY'
import json
import re
import stat
import sys
from pathlib import Path


path = Path(sys.argv[1])
expected_attempt = sys.argv[2]
try:
    details = path.lstat()
except OSError as exc:
    raise SystemExit("The requested Platform v2 attempt report is unavailable") from exc
if (
    not stat.S_ISREG(details.st_mode)
    or path.is_symlink()
    or details.st_uid != 0
    or stat.S_IMODE(details.st_mode) & 0o077
    or details.st_size <= 0
    or details.st_size > 64 * 1024
):
    raise SystemExit("The requested Platform v2 attempt report is unsafe")
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as exc:
    raise SystemExit("The requested Platform v2 attempt report is unreadable") from exc
if not isinstance(data, dict) or data.get("schema_version") != 1:
    raise SystemExit("The requested Platform v2 attempt report has an unsupported schema")
if data.get("attempt_id") != expected_attempt:
    raise SystemExit("The requested Platform v2 attempt identity does not match")
if data.get("operation") not in {"preflight", "deploy"}:
    raise SystemExit("The requested Platform v2 operation is invalid")
if data.get("result") not in {"running", "success", "failed"}:
    raise SystemExit("The requested Platform v2 result is invalid")

selected = {}
for key in (
    "schema_version",
    "operation",
    "attempt_id",
    "repository",
    "release_commit",
    "source_commit",
    "platform_version",
    "manifest_sha256",
    "started_at",
    "updated_at",
    "state",
    "result",
    "failure",
    "failure_detail",
    "recovery",
):
    value = data.get(key)
    if value is not None and not isinstance(value, (str, int)):
        raise SystemExit(f"The requested Platform v2 attempt field is invalid: {key}")
    selected[key] = value
if not re.fullmatch(r"gh-[0-9]{1,20}-[1-9][0-9]{0,5}", selected["attempt_id"]):
    raise SystemExit("The requested Platform v2 attempt identifier is malformed")
if (
    isinstance(selected["failure_detail"], str)
    and len(selected["failure_detail"].encode("utf-8")) > 32 * 1024 + 3
):
    raise SystemExit("The requested Platform v2 failure detail is oversized")
print("B-UH Platform v2 guarded attempt report")
print(json.dumps(selected, sort_keys=True, separators=(",", ":")))
PY
    python3 /usr/local/libexec/buh-redact-diagnostics "${raw_attempt}"
    exit 0
fi

if [[ ! -d "${APP_DIR}" || ! -f "${APP_DIR}/docker-compose.yml" || ! -f "${APP_DIR}/.env" ]]; then
    echo "Alliance Auth Docker was not found at ${APP_DIR}." >&2
    exit 69
fi

cd "${APP_DIR}"

compose() {
    docker compose --env-file=.env "$@"
}

runtime_fingerprint() {
    local runtime_tag image_id repo_digests
    local services docker_version compose_version

    # Compose performs interpolation, but awk permits only AA_DOCKER_TAG to
    # cross the process boundary. No other .env value is retained or printed.
    runtime_tag="$(
        compose config --environment 2>/dev/null |
            awk -F= '$1 == "AA_DOCKER_TAG" {print substr($0, index($0, "=") + 1)}'
    )"
    if [[ -z "${runtime_tag}" || "${runtime_tag}" == *$'\n'* ]]; then
        echo "AA_DOCKER_TAG must resolve exactly once." >&2
        exit 78
    fi
    # Docker's Go-template formatter prints backslash escapes literally, so
    # collect these fields separately instead of relying on a tab delimiter.
    image_id="$(
        docker image inspect --format '{{.Id}}' "${runtime_tag}"
    )"
    repo_digests="$(
        docker image inspect --format '{{json .RepoDigests}}' "${runtime_tag}"
    )"

    services="$(compose config --services | sed '/^$/d' | sort -u)"
    docker_version="$(docker version --format '{{.Server.Version}}')"
    compose_version="$(docker compose version --short)"

    python3 - \
        "${runtime_tag}" "${image_id}" "${repo_digests}" "${services}" \
        "${docker_version}" "${compose_version}" <<'PY'
import datetime
import json
import re
import socket
import sys


tag, image_id, raw_digests, raw_services, docker_version, compose_version = sys.argv[1:]
image_ref = re.compile(
    r"[a-z0-9]+(?:[._/-][a-z0-9]+)*"
    r"(?::[A-Za-z0-9][A-Za-z0-9._-]{0,127})?"
    r"(?:@sha256:[0-9a-f]{64})?"
)
digest_ref = re.compile(
    r"[a-z0-9]+(?:[._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}"
)
if not image_ref.fullmatch(tag):
    raise SystemExit("AA_DOCKER_TAG is not a canonical public image reference")
if not re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
    raise SystemExit("Docker returned a malformed image ID")
try:
    digests = sorted(set(json.loads(raw_digests)))
except (TypeError, ValueError):
    raise SystemExit("Docker returned malformed repository digests") from None
if not digests or not all(isinstance(item, str) and digest_ref.fullmatch(item) for item in digests):
    raise SystemExit("The production base image has no canonical repository digest")


def repository(ref: str) -> str:
    base = ref.split("@", 1)[0]
    leaf = base.rsplit("/", 1)[-1]
    if ":" in leaf:
        base = base[: -(len(leaf) - leaf.rfind(":"))]
    return base


if "@sha256:" in tag:
    candidates = [item for item in digests if item == tag]
else:
    target = repository(tag)
    candidates = [
        item
        for item in digests
        if repository(item) == target or repository(item).endswith("/" + target)
    ]
if len(candidates) != 1:
    raise SystemExit("The production base image did not resolve to exactly one digest")

services = sorted(set(raw_services.splitlines()))
if not services or not all(re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,62}", item) for item in services):
    raise SystemExit("Docker Compose returned malformed service names")
if not re.fullmatch(r"[0-9][0-9A-Za-z.+~-]{0,63}", docker_version):
    raise SystemExit("Docker returned a malformed server version")
if not re.fullmatch(r"[0-9][0-9A-Za-z.+~-]{0,63}", compose_version):
    raise SystemExit("Docker Compose returned a malformed version")
host = socket.gethostname()
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", host):
    raise SystemExit("Host name is not safe to report")

print("B-UH Alliance Auth guarded runtime fingerprint")
print("schema_version=1")
print("generated_utc=" + datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
print("host=" + host)
print("aa_docker_tag=" + tag)
print("production_runtime_base_image=" + candidates[0])
print("runtime_image_id=" + image_id)
print("compose_services=" + ",".join(services))
print("docker_server_version=" + docker_version)
print("docker_compose_version=" + compose_version)
PY
}

if [[ "${mode}" == "fingerprint" ]]; then
    runtime_fingerprint
    exit 0
fi

section() {
    printf '\n===== %s =====\n' "$1"
}

umask 077
raw_output="$(mktemp -t buh-diagnostics-raw.XXXXXX)"
trap 'rm -f -- "${raw_output}"' EXIT

{
    printf 'B-UH Alliance Auth guarded diagnostics\n'
    printf 'generated_utc=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'host=%s\n' "$(hostname)"
    printf 'window_minutes=%s\n' "${minutes}"

    section "HOST"
    uptime || true
    free -h || true
    df -h / || true
    systemctl is-active docker 2>&1 || true

    section "COMPOSE STATUS"
    compose ps -a 2>&1 || true

    section "CONTAINER RESOURCE SNAPSHOT"
    mapfile -t container_ids < <(compose ps -aq 2>/dev/null | sed '/^$/d' | sort -u)
    if ((${#container_ids[@]})); then
        docker stats --no-stream \
            --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}\t{{.BlockIO}}\t{{.PIDs}}' \
            "${container_ids[@]}" 2>&1 || true
    else
        echo "No Compose containers were found."
    fi

    section "CONTAINER STATES"
    for container_id in "${container_ids[@]:-}"; do
        [[ -n "${container_id}" ]] || continue
        docker inspect --format \
            'name={{.Name}} service={{index .Config.Labels "com.docker.compose.service"}} state={{.State.Status}} exit={{.State.ExitCode}} restarts={{.RestartCount}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} error={{.State.Error}}' \
            "${container_id}" 2>&1 || true
    done

    section "CELERY WORKLOAD"
    for celery_command in active reserved scheduled stats; do
        printf '\n--- celery inspect %s ---\n' "${celery_command}"
        timeout 20 docker compose --env-file=.env exec -T allianceauth_worker \
            celery -A myauth inspect "${celery_command}" --timeout=5 2>&1 || true
    done

    section "RECENT CONTAINER LOGS"
    for container_id in "${container_ids[@]:-}"; do
        [[ -n "${container_id}" ]] || continue
        container_name="$(docker inspect --format '{{.Name}}' "${container_id}" 2>/dev/null | sed 's#^/##')"
        printf '\n--- %s ---\n' "${container_name:-unknown-container}"
        docker logs --since "${minutes}m" --tail "${MAX_LOG_LINES_PER_CONTAINER}" \
            "${container_id}" 2>&1 || true
    done
} >"${raw_output}" 2>&1

# Redaction is intentionally performed on the VPS before anything leaves it.
# The observer does not emit environment contents; this is a second safety
# layer for credentials that an application may accidentally place in its logs.
python3 /usr/local/libexec/buh-redact-diagnostics "${raw_output}"
